<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>KAIVYRA — Healthcare, Technology & Education</title>

<meta
  name="description"
  content="KAIVYRA explores meaningful problems across healthcare, technology, artificial intelligence and education, turning research and ideas into useful solutions."
/>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
  rel="stylesheet"
/>

<style>

/* =========================================================
   KAIVYRA — DEDICATED HOMEPAGE
   ========================================================= */

:root{
  --navy-950:#050f1f;
  --navy-900:#09172c;
  --navy-850:#0c203b;
  --navy-800:#102e54;
  --navy-700:#154676;

  --cyan-500:#1fc5c6;
  --cyan-400:#33d6d1;
  --cyan-300:#8beae6;

  --ink:#102039;
  --ink-soft:#263852;
  --muted:#65748a;

  --bg:#f5f8fb;
  --white:#ffffff;
  --line:#e5ebf2;

  --shadow-sm:0 10px 30px rgba(5,15,31,.06);
  --shadow-md:0 20px 55px rgba(5,15,31,.09);
  --shadow-lg:0 30px 80px rgba(5,15,31,.13);

  --max:1200px;
  --radius:24px;
}

*,
*::before,
*::after{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:var(--ink);
  background:var(--bg);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

body.menu-open{
  overflow:hidden;
}

h1,
h2,
h3,
h4{
  margin:0;
  font-family:'Poppins',sans-serif;
}

p{
  margin:0;
}

a{
  color:inherit;
  text-decoration:none;
}

button{
  font:inherit;
}

img,
svg{
  display:block;
}

.wrap{
  width:min(calc(100% - 48px),var(--max));
  margin-inline:auto;
}


/* =========================================================
   HEADER
   ========================================================= */

.site-header{
  position:absolute;
  inset:0 0 auto;
  z-index:100;
  padding:24px 0;
}

.nav-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.brand{
  display:inline-flex;
  align-items:center;
  gap:11px;
  flex-shrink:0;
}

.brand-mark{
  width:32px;
  height:32px;
}

.brand-text{
  color:#fff;
  font-family:'Poppins',sans-serif;
  font-size:18px;
  font-weight:700;
  letter-spacing:.045em;
}


/* =========================================================
   DESKTOP NAV
   ========================================================= */

.nav-links{
  display:flex;
  align-items:center;
  gap:30px;
  margin-left:auto;
}

.nav-links > a,
.nav-dropdown-btn{
  position:relative;
  color:rgba(255,255,255,.78);
  font-size:13.5px;
  font-weight:500;
  transition:color .2s ease;
}

.nav-links > a::after{
  content:"";
  position:absolute;
  left:0;
  right:100%;
  bottom:-7px;
  height:1px;
  background:var(--cyan-400);
  transition:right .2s ease;
}

.nav-links > a:hover{
  color:#fff;
}

.nav-links > a:hover::after{
  right:0;
}


/* =========================================================
   NAV DROPDOWN
   ========================================================= */

.nav-item{
  position:relative;
  display:flex;
  align-items:center;
}

.nav-dropdown-btn{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:0;
  border:0;
  background:none;
  font-family:'Inter',sans-serif;
  cursor:pointer;
}

.nav-dropdown-btn:hover,
.nav-item.open .nav-dropdown-btn{
  color:#fff;
}

.nav-dropdown-btn::after{
  content:"";
  width:6px;
  height:6px;
  margin-top:-3px;
  border-right:1.5px solid currentColor;
  border-bottom:1.5px solid currentColor;
  transform:rotate(45deg);
  transition:transform .2s ease,margin .2s ease;
}

.nav-item.open .nav-dropdown-btn::after{
  transform:rotate(225deg);
  margin-top:3px;
}


/* Dropdown box */

.nav-dropdown{
  position:absolute;
  top:calc(100% + 18px);
  left:50%;
  width:250px;
  padding:9px;

  border:1px solid #e5ebf2;
  border-radius:16px;
  background:#fff;

  box-shadow:0 22px 60px rgba(5,15,31,.18);

  opacity:0;
  visibility:hidden;
  transform:translate(-50%,-8px);
  pointer-events:none;

  transition:
    opacity .18s ease,
    transform .18s ease,
    visibility .18s ease;
}

.nav-item.open .nav-dropdown{
  opacity:1;
  visibility:visible;
  transform:translate(-50%,0);
  pointer-events:auto;
}


/* Dropdown arrow */

.nav-dropdown::before{
  content:"";
  position:absolute;
  top:-6px;
  left:50%;

  width:11px;
  height:11px;

  background:#fff;
  border-left:1px solid #e5ebf2;
  border-top:1px solid #e5ebf2;

  transform:translateX(-50%) rotate(45deg);
}


/* Dropdown links */

.nav-dropdown a{
  position:relative;

  display:flex;
  flex-direction:column;
  align-items:flex-start;

  width:100%;
  padding:12px 13px;

  border-radius:10px;

  color:#102039;

  font-size:13px;
  font-weight:600;
  line-height:1.35;

  transition:
    background .18s ease,
    color .18s ease;
}

.nav-dropdown a::after{
  display:none;
}

.nav-dropdown a:hover{
  color:#087f88;
  background:#f0f8f9;
}

.nav-dropdown a span{
  margin-top:2px;

  color:#718096;

  font-size:11px;
  font-weight:400;
  line-height:1.4;
}

.nav-dropdown a:hover span{
  color:#5d707f;
}


/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.header-actions{
  display:flex;
  align-items:center;
  gap:9px;
}

.header-icon{
  width:38px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;
  border:1px solid rgba(255,255,255,.13);

  background:rgba(255,255,255,.07);
  color:#fff;

  transition:.2s ease;
}

.header-icon:hover{
  background:rgba(255,255,255,.14);
}

.lang{
  width:auto;
  padding:0 14px;
  border-radius:20px;
  font-size:12px;
  font-weight:600;
}

.mobile-menu-btn{
  display:none;

  width:40px;
  height:40px;

  align-items:center;
  justify-content:center;

  border:1px solid rgba(255,255,255,.16);
  border-radius:50%;

  background:rgba(255,255,255,.08);
  color:#fff;

  cursor:pointer;
}


/* =========================================================
   HERO
   ========================================================= */

.hero{
  position:relative;
  min-height:720px;
  overflow:hidden;

  color:#fff;

  background:
    radial-gradient(
      circle at 80% 25%,
      rgba(51,214,209,.13),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      var(--navy-950) 0%,
      var(--navy-900) 45%,
      var(--navy-700) 100%
    );
}

.hero::after{
  content:"";

  position:absolute;
  left:0;
  right:0;
  bottom:-1px;

  height:160px;

  background:linear-gradient(
    to bottom,
    transparent,
    var(--bg)
  );

  pointer-events:none;
}

.hero-grid{
  position:absolute;
  inset:0;

  opacity:.15;

  background-image:
    linear-gradient(
      rgba(255,255,255,.07) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.07) 1px,
      transparent 1px
    );

  background-size:70px 70px;

  mask-image:linear-gradient(
    to bottom,
    black,
    transparent 75%
  );
}

.hero-glow{
  position:absolute;

  width:650px;
  height:650px;

  right:-230px;
  top:-170px;

  border-radius:50%;

  background:radial-gradient(
    circle,
    rgba(51,214,209,.25),
    rgba(51,214,209,.05) 40%,
    transparent 70%
  );
}

.hero-content{
  position:relative;
  z-index:3;

  min-height:720px;

  display:grid;
  grid-template-columns:1.03fr .97fr;

  align-items:center;

  gap:40px;

  padding-top:70px;
  padding-bottom:120px;
}

.hero-copy{
  max-width:620px;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:9px;

  margin-bottom:20px;

  color:var(--cyan-300);

  font-size:12.5px;
  font-weight:600;
}

.eyebrow-dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--cyan-400);

  box-shadow:
    0 0 0 5px rgba(51,214,209,.10);
}

.hero-wordmark{
  margin-bottom:14px;

  font-size:clamp(44px,6vw,70px);
  line-height:1;

  font-weight:700;
  letter-spacing:.055em;

  background:
    linear-gradient(
      90deg,
      #fff 10%,
      #bcecff 90%
    );

  -webkit-background-clip:text;
  background-clip:text;

  color:transparent;
}

.hero-title{
  max-width:700px;

  font-size:clamp(27px,3.4vw,42px);
  line-height:1.25;

  font-weight:600;
  letter-spacing:-.02em;
}

.hero-lede{
  max-width:54ch;

  margin-top:20px;

  color:rgba(255,255,255,.68);

  font-size:16px;
  line-height:1.8;
}

.hero-actions{
  display:flex;
  flex-wrap:wrap;

  gap:12px;

  margin-top:32px;
}

.primary-btn,
.secondary-btn{
  min-height:50px;

  display:inline-flex;
  align-items:center;
  justify-content:center;

  gap:10px;

  padding:0 23px;

  border-radius:27px;

  font-size:14px;
  font-weight:600;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.primary-btn{
  color:#062128;

  background:
    linear-gradient(
      90deg,
      #20c4c7,
      #53ded7
    );

  box-shadow:
    0 14px 32px rgba(51,214,209,.22);
}

.secondary-btn{
  color:#fff;

  border:1px solid rgba(255,255,255,.18);

  background:rgba(255,255,255,.06);
}

.primary-btn:hover,
.secondary-btn:hover{
  transform:translateY(-2px);
}

.secondary-btn:hover{
  background:rgba(255,255,255,.11);
}


/* =========================================================
   HERO ART
   ========================================================= */

.hero-visual{
  position:relative;
  height:470px;
}

.hero-visual svg{
  width:100%;
  height:100%;
}

.visual-frame{
  position:absolute;
  inset:70px 35px 50px;

  border:1px solid rgba(127,232,228,.11);
  border-radius:32px;

  transform:rotate(-2deg);
}

.visual-caption{
  position:absolute;

  right:15px;
  bottom:38px;

  padding:9px 13px;

  border:1px solid rgba(255,255,255,.11);
  border-radius:12px;

  background:rgba(255,255,255,.05);

  color:rgba(255,255,255,.55);

  font-size:10.5px;
  letter-spacing:.04em;

  backdrop-filter:blur(10px);
}


/* =========================================================
   FOCUS
   ========================================================= */

.focus-wrap{
  position:relative;
  z-index:8;

  margin-top:-92px;
}

.focus-card{
  padding:48px 50px 52px;

  background:#fff;

  border:1px solid rgba(10,25,50,.04);
  border-radius:var(--radius);

  box-shadow:var(--shadow-lg);
}

.section-kicker{
  color:#159ba2;

  font-size:12px;
  font-weight:600;

  letter-spacing:.055em;
  text-transform:uppercase;
}

.focus-heading{
  margin-top:8px;

  text-align:center;

  font-size:27px;
  font-weight:600;
}

.focus-intro{
  max-width:590px;

  margin:11px auto 38px;

  text-align:center;

  color:var(--muted);

  font-size:14px;
}

.focus-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);

  gap:1px;

  overflow:hidden;

  border:1px solid var(--line);
  border-radius:18px;
}

.focus-item{
  position:relative;

  padding:32px 28px;

  text-align:center;

  background:#fff;

  transition:background .2s ease;
}

.focus-item + .focus-item{
  border-left:1px solid var(--line);
}

.focus-item:hover{
  background:#fbfdfe;
}

.icon-circle{
  width:62px;
  height:62px;

  margin:0 auto 18px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  color:var(--cyan-300);

  background:
    linear-gradient(
      145deg,
      var(--navy-800),
      var(--navy-700)
    );

  box-shadow:
    0 10px 24px rgba(10,25,50,.13);
}

.focus-item h3{
  font-size:16px;
  font-weight:600;
}

.focus-item p{
  max-width:30ch;

  margin:7px auto 0;

  color:var(--muted);

  font-size:13px;
}


/* =========================================================
   GENERIC SECTION
   ========================================================= */

.section{
  padding:110px 0;
}

.section-head{
  max-width:690px;

  margin:0 auto 55px;

  text-align:center;
}

.section-head h2{
  margin-top:9px;

  font-size:clamp(26px,3.2vw,36px);
  line-height:1.25;

  font-weight:600;
  letter-spacing:-.02em;
}

.section-head p:not(.section-kicker){
  margin-top:14px;

  color:var(--muted);

  font-size:15px;
}


/* =========================================================
   ABOUT
   ========================================================= */

.about-section{
  padding-top:30px;
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;

  gap:28px;

  align-items:stretch;
}

.about-card{
  min-height:370px;

  padding:48px;

  border-radius:var(--radius);

  background:#fff;

  box-shadow:var(--shadow-md);
}

.about-card h2{
  margin-top:8px;

  font-size:30px;
  line-height:1.25;

  font-weight:600;
}

.about-card p{
  max-width:56ch;

  margin-top:19px;

  color:var(--muted);

  font-size:15px;
  line-height:1.8;
}

.text-link{
  display:inline-flex;
  align-items:center;

  gap:8px;

  margin-top:25px;

  color:#117e89;

  font-size:13px;
  font-weight:600;
}

.about-visual{
  position:relative;

  min-height:370px;

  overflow:hidden;

  border-radius:var(--radius);

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(51,214,209,.18),
      transparent 45%
    ),
    linear-gradient(
      135deg,
      #eaf6f7,
      #e7f0f7
    );
}

.about-visual::before,
.about-visual::after{
  content:"";

  position:absolute;

  border:1px solid rgba(21,70,118,.10);

  border-radius:50%;
}

.about-visual::before{
  width:310px;
  height:310px;

  left:50%;
  top:50%;

  transform:translate(-50%,-50%);
}

.about-visual::after{
  width:210px;
  height:210px;

  left:50%;
  top:50%;

  transform:translate(-50%,-50%);
}

.about-network{
  position:absolute;
  inset:0;

  display:flex;
  align-items:center;
  justify-content:center;
}

.network-core{
  position:relative;

  width:82px;
  height:82px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  color:var(--cyan-400);

  background:var(--navy-800);

  box-shadow:
    0 20px 40px rgba(10,25,50,.20);
}

.network-node{
  position:absolute;

  width:13px;
  height:13px;

  border-radius:50%;

  background:var(--cyan-400);

  box-shadow:
    0 0 0 7px rgba(51,214,209,.10);
}

.node-1{
  transform:translate(-130px,-75px);
}

.node-2{
  transform:translate(130px,-75px);
}

.node-3{
  transform:translate(-140px,75px);
}

.node-4{
  transform:translate(140px,75px);
}

.network-lines{
  position:absolute;

  inset:0;

  width:100%;
  height:100%;
}


/* =========================================================
   BUILDING
   ========================================================= */

.build-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);

  gap:20px;
}

.build-card{
  position:relative;

  min-height:260px;

  padding:32px;

  border:1px solid var(--line);
  border-radius:20px;

  background:#fff;

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.build-card:hover{
  transform:translateY(-5px);

  box-shadow:var(--shadow-md);
}

.card-number{
  color:#b0bac8;

  font-size:12px;
  font-weight:600;

  letter-spacing:.08em;
}

.build-card h3{
  margin-top:40px;

  font-size:19px;
  font-weight:600;
}

.build-card p{
  margin-top:10px;

  color:var(--muted);

  font-size:13.5px;
  line-height:1.7;
}

.card-arrow{
  position:absolute;

  right:30px;
  bottom:30px;

  width:35px;
  height:35px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  color:var(--navy-800);

  background:#f1f6fa;
}


/* =========================================================
   APPROACH
   ========================================================= */

.approach-section{
  background:#fff;
}

.approach-grid{
  display:grid;
  grid-template-columns:.85fr 1.15fr;

  gap:80px;

  align-items:center;
}

.approach-copy h2{
  margin-top:9px;

  font-size:32px;
  line-height:1.25;
}

.approach-copy > p{
  max-width:48ch;

  margin-top:18px;

  color:var(--muted);

  font-size:15px;
}

.approach-list{
  display:flex;
  flex-direction:column;

  gap:0;
}

.approach-item{
  display:grid;
  grid-template-columns:55px 1fr;

  gap:20px;

  padding:24px 0;

  border-bottom:1px solid var(--line);
}

.approach-item:first-child{
  padding-top:0;
}

.approach-number{
  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  color:var(--navy-800);

  background:#edf6f7;

  font-family:'Poppins',sans-serif;

  font-size:13px;
  font-weight:600;
}

.approach-item h3{
  font-size:16px;
  font-weight:600;
}

.approach-item p{
  margin-top:5px;

  color:var(--muted);

  font-size:13px;
}


/* =========================================================
   EXPLORATION
   ========================================================= */

.explore-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);

  gap:14px;
}

.explore-card{
  min-height:190px;

  padding:25px;

  border-radius:18px;

  background:#fff;

  border:1px solid var(--line);
}

.explore-icon{
  width:40px;
  height:40px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:11px;

  color:var(--navy-800);

  background:#edf5f8;
}

.explore-card h3{
  margin-top:25px;

  font-size:15px;
  font-weight:600;
}

.explore-card p{
  margin-top:7px;

  color:var(--muted);

  font-size:12.5px;
}


/* =========================================================
   CTA
   ========================================================= */

.final-cta{
  padding:100px 0;
}

.cta-panel{
  position:relative;

  overflow:hidden;

  padding:70px 50px;

  text-align:center;

  border-radius:28px;

  color:#fff;

  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(51,214,209,.17),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      var(--navy-950),
      var(--navy-800)
    );

  box-shadow:var(--shadow-lg);
}

.cta-panel::before{
  content:"";

  position:absolute;

  width:300px;
  height:300px;

  left:-120px;
  bottom:-180px;

  border:1px solid rgba(127,232,228,.10);

  border-radius:50%;
}

.cta-panel h2{
  position:relative;

  font-size:clamp(27px,3.5vw,39px);

  font-weight:600;
}

.cta-panel p{
  position:relative;

  max-width:620px;

  margin:13px auto 0;

  color:rgba(255,255,255,.66);

  font-size:15px;
}

.cta-panel .primary-btn{
  position:relative;

  margin-top:28px;
}


/* =========================================================
   FOOTER
   ========================================================= */

footer{
  padding:48px 0 28px;

  color:#fff;

  background:var(--navy-950);
}

.footer-main{
  display:grid;

  grid-template-columns:1.4fr .6fr .6fr;

  gap:60px;

  padding-bottom:42px;

  border-bottom:1px solid rgba(255,255,255,.09);
}

.footer-brand-copy{
  max-width:350px;

  margin-top:16px;

  color:rgba(255,255,255,.48);

  font-size:12.5px;
  line-height:1.7;
}

.footer-col h4{
  margin-bottom:15px;

  color:#fff;

  font-size:12px;
  font-weight:600;

  text-transform:uppercase;
  letter-spacing:.08em;
}

.footer-col a{
  display:block;

  margin:9px 0;

  color:rgba(255,255,255,.55);

  font-size:12.5px;

  transition:color .2s ease;
}

.footer-col a:hover{
  color:#fff;
}

.footer-bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:20px;

  padding-top:23px;

  color:rgba(255,255,255,.36);

  font-size:11.5px;
}


/* =========================================================
   MOBILE NAV
   ========================================================= */

.mobile-panel{
  position:fixed;

  inset:0;

  z-index:90;

  display:none;

  overflow-y:auto;

  padding:90px 28px 30px;

  background:var(--navy-950);
}

.mobile-panel.active{
  display:block;
}

.mobile-panel > a{
  display:block;

  padding:16px 0;

  border-bottom:1px solid rgba(255,255,255,.08);

  color:#fff;

  font-family:'Poppins',sans-serif;

  font-size:20px;
}


/* Mobile groups */

.mobile-nav-group{
  border-bottom:1px solid rgba(255,255,255,.08);
}

.mobile-dropdown-btn{
  width:100%;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:16px 0;

  border:0;
  background:none;

  color:#fff;

  font-family:'Poppins',sans-serif;

  font-size:20px;

  text-align:left;

  cursor:pointer;
}

.mobile-dropdown-btn::after{
  content:"+";

  color:var(--cyan-400);

  font-size:23px;
  font-weight:400;
}

.mobile-nav-group.open .mobile-dropdown-btn::after{
  content:"−";
}

.mobile-dropdown{
  display:none;

  padding:2px 0 10px 15px;
}

.mobile-nav-group.open .mobile-dropdown{
  display:block;
}

.mobile-dropdown a{
  display:block;

  padding:10px 0;

  border:0;

  color:rgba(255,255,255,.68);

  font-family:'Inter',sans-serif;

  font-size:14px;
}

.mobile-dropdown a:hover{
  color:var(--cyan-400);
}


/* =========================================================
   REVEAL
   ========================================================= */

.reveal{
  opacity:0;

  transform:translateY(18px);

  transition:
    opacity .65s ease,
    transform .65s ease;
}

.reveal.visible{
  opacity:1;

  transform:none;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:1000px){

  .nav-links{
    gap:20px;
  }

  .nav-dropdown{
    width:225px;
  }

  .hero-content{
    grid-template-columns:1fr;

    padding-top:130px;
  }

  .hero-copy{
    max-width:700px;
  }

  .hero-visual{
    display:none;
  }

  .hero{
    min-height:650px;
  }

  .hero-content{
    min-height:650px;
  }

  .focus-grid{
    grid-template-columns:1fr;
  }

  .focus-item + .focus-item{
    border-left:0;
    border-top:1px solid var(--line);
  }

  .about-grid,
  .approach-grid{
    grid-template-columns:1fr;
  }

  .explore-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .build-grid{
    grid-template-columns:1fr;
  }

  .footer-main{
    grid-template-columns:1fr 1fr;
  }

  .footer-main > :first-child{
    grid-column:1 / -1;
  }
}


@media(max-width:760px){

  .wrap{
    width:min(calc(100% - 34px),var(--max));
  }

  .site-header{
    padding:18px 0;
  }

  .nav-links,
  .header-actions{
    display:none;
  }

  .mobile-menu-btn{
    display:flex;
  }

  .hero-content{
    padding-top:110px;
    padding-bottom:100px;
  }

  .hero{
    min-height:620px;
  }

  .hero-content{
    min-height:620px;
  }

  .hero-wordmark{
    font-size:43px;
  }

  .hero-title{
    font-size:27px;
  }

  .hero-lede{
    font-size:14.5px;
  }

  .focus-wrap{
    margin-top:-70px;
  }

  .focus-card{
    padding:35px 20px 30px;
  }

  .focus-heading{
    font-size:23px;
  }

  .section{
    padding:75px 0;
  }

  .about-card{
    padding:32px 26px;
  }

  .about-card h2{
    font-size:25px;
  }

  .about-visual{
    min-height:300px;
  }

  .approach-grid{
    gap:45px;
  }

  .approach-copy h2{
    font-size:27px;
  }

  .explore-grid{
    grid-template-columns:1fr;
  }

  .final-cta{
    padding:65px 0;
  }

  .cta-panel{
    padding:50px 25px;

    border-radius:22px;
  }

  .footer-main{
    grid-template-columns:1fr;

    gap:30px;
  }

  .footer-main > :first-child{
    grid-column:auto;
  }

  .footer-bottom{
    flex-direction:column;
    align-items:flex-start;
  }
}


@media(prefers-reduced-motion:reduce){

  html{
    scroll-behavior:auto;
  }

  .reveal{
    opacity:1;

    transform:none;

    transition:none;
  }

  *,
  *::before,
  *::after{
    transition:none !important;
  }
}

</style>
</head>


