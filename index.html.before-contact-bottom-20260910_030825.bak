  background:#fff;
  box-shadow:0 18px 45px rgba(5,15,31,.18);

  opacity:0;
  visibility:hidden;
  transform:translateY(-5px);
  pointer-events:none;

  transition:
    opacity .16s ease,
    transform .16s ease,
    visibility .16s ease;

  z-index:300;
}

.kaivyra-lang-wrap.open .kaivyra-lang-menu{
  opacity:1;
  visibility:visible;
  transform:none;
  pointer-events:auto;
}

.kaivyra-lang-option{
  width:100%;
  display:flex;
  align-items:center;

  padding:9px 10px;

  border:0;
  border-radius:8px;

  background:none;
  color:#102039;

  font-family:'Inter',sans-serif;
  font-size:12px;
  font-weight:500;

  text-align:left;
  cursor:pointer;
}

.kaivyra-lang-option:hover,
.kaivyra-lang-option.active{
  background:#f0f8f9;
  color:#087f88;
}

.kaivyra-search-wrap{
  position:relative;
}

.kaivyra-search-btn{
  width:34px;
  height:34px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:0;

  border:1px solid rgba(255,255,255,.13);
  border-radius:50%;

  background:rgba(255,255,255,.06);
  color:#fff;

  cursor:pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}

.kaivyra-search-btn:hover{
  background:rgba(255,255,255,.14);
  transform:translateY(-1px);
}

.kaivyra-search-btn svg{
  width:14px;
  height:14px;
}

.kaivyra-search-panel{
  position:absolute;

  top:calc(100% + 12px);
  right:0;

  width:290px;
  padding:10px;

  border:1px solid #e5ebf2;
  border-radius:14px;

  background:#fff;

  box-shadow:0 22px 60px rgba(5,15,31,.20);

  opacity:0;
  visibility:hidden;
  transform:translateY(-6px);
  pointer-events:none;

  transition:
    opacity .16s ease,
    transform .16s ease,
    visibility .16s ease;

  z-index:400;
}

.kaivyra-search-wrap.open .kaivyra-search-panel{
  opacity:1;
  visibility:visible;
  transform:none;
  pointer-events:auto;
}

.kaivyra-search-input-row{
  display:flex;
  align-items:center;
  gap:8px;

  padding:2px;
}

.kaivyra-search-input{
  width:100%;

  height:38px;

  padding:0 11px;

  border:1px solid #dfe7ef;
  border-radius:9px;

  outline:none;

  color:#102039;
