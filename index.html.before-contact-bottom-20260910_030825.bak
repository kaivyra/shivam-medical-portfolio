  .kaivyra-lang-wrap{
    display:none;
  }
}
</style>

<script>
(function(){

  function initKaivyraNavEnhancements(){

    const headerActions =
      document.querySelector(".header-actions");

    if(!headerActions) return;


    /* =====================================================
       FIND EXISTING EN CONTROL
       ===================================================== */

    let oldLang =
      headerActions.querySelector(".lang");

    if(oldLang){

      oldLang.classList.add("kaivyra-old-lang");

      const langWrap =
        document.createElement("div");

      langWrap.className =
        "kaivyra-lang-wrap";


      const langBtn =
        document.createElement("button");

      langBtn.type = "button";
      langBtn.className = "kaivyra-lang-btn";
      langBtn.setAttribute(
        "aria-label",
        "Choose language"
      );

      langBtn.innerHTML =
        '<span class="kaivyra-current-lang">EN</span>' +
        '<span class="kaivyra-lang-chevron"></span>';


      const langMenu =
        document.createElement("div");

      langMenu.className =
        "kaivyra-lang-menu";

      langMenu.innerHTML =

        '<button type="button" class="kaivyra-lang-option active" data-lang="en">' +
          'English' +
        '</button>' +

        '<button type="button" class="kaivyra-lang-option" data-lang="hi">' +
          'हिन्दी' +
        '</button>';


      langWrap.appendChild(langBtn);
      langWrap.appendChild(langMenu);

      oldLang.replaceWith(langWrap);


      langBtn.addEventListener("click", function(event){

        event.stopPropagation();

        const open =
          langWrap.classList.toggle("open");

        searchWrap &&
          searchWrap.classList.remove("open");

      });


      langMenu
        .querySelectorAll(".kaivyra-lang-option")
        .forEach(option => {

          option.addEventListener("click", function(){

            const lang =
              this.getAttribute("data-lang");

            setLanguage(lang);

            langWrap.classList.remove("open");

          });

        });

    }


    /* =====================================================
       COMPACT SEARCH
       ===================================================== */

    let searchWrap =
      headerActions.querySelector(".kaivyra-search-wrap");

    if(!searchWrap){

      searchWrap =
        document.createElement("div");

      searchWrap.className =
        "kaivyra-search-wrap";


      const searchBtn =
        document.createElement("button");

      searchBtn.type = "button";
      searchBtn.className =
        "kaivyra-search-btn";

      searchBtn.setAttribute(
        "aria-label",
        "Search KAIVYRA"
      );

      searchBtn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
          '<circle cx="11" cy="11" r="6.5"></circle>' +
          '<line x1="16" y1="16" x2="21" y2="21"></line>' +
        '</svg>';


      const panel =
        document.createElement("div");

      panel.className =
        "kaivyra-search-panel";

      panel.innerHTML =
        '<div class="kaivyra-search-input-row">' +
          '<input class="kaivyra-search-input" type="search" autocomplete="off" placeholder="Search KAIVYRA..." aria-label="Search website">' +
        '</div>' +
        '<div class="kaivyra-search-results"></div>';


      searchWrap.appendChild(searchBtn);
      searchWrap.appendChild(panel);


      /*
         Existing header icon is the old search/explore icon.
         Replace it instead of creating a duplicate.
      */

      const existingIcon =
        headerActions.querySelector(
          '.header-icon:not(.lang)'
        );

      if(existingIcon){
        existingIcon.replaceWith(searchWrap);
      }else{
        headerActions.insertBefore(
          searchWrap,
          headerActions.firstChild
        );
      }


      const input =
        panel.querySelector(
          ".kaivyra-search-input"
        );

      const results =
        panel.querySelector(
          ".kaivyra-search-results"
        );


      searchBtn.addEventListener(
        "click",
        function(event){

          event.stopPropagation();

          const open =
            searchWrap.classList.toggle("open");

          document
            .querySelectorAll(".kaivyra-lang-wrap")
            .forEach(x =>
              x.classList.remove("open")
            );

          if(open){

            setTimeout(
              () => input.focus(),
              50
            );

            renderSearchResults("");

          }

        }
      );


      input.addEventListener(
        "input",
        function(){

          renderSearchResults(
            input.value.trim()
          );

        }
      );


      input.addEventListener(
        "keydown",
        function(event){

          if(event.key === "Escape"){

            searchWrap.classList.remove(
              "open"
            );

            input.blur();

          }

        }
      );


      function renderSearchResults(query){

        const sections =
          Array.from(
            document.querySelectorAll(
              "main section, main [id]"
            )
          );

        const unique = [];

        sections.forEach(element => {

          if(
            unique.includes(element) ||
            element.closest(".kaivyra-search-panel")
          ) return;

          if(!element.id) return;

          const heading =
            element.querySelector(
              "h1,h2,h3"
            );

          const title =
            heading
              ? heading.textContent.trim()
              : element.id;

          const text =
            element.textContent
              .replace(/\s+/g," ")
              .trim();

          if(!text) return;

          unique.push({
            element,
            title,
            text
          });

        });


        let matches = unique;


        if(query){

          const q =
            query.toLowerCase();

          matches =
            unique.filter(item =>
              (
                item.title + " " + item.text
              )
              .toLowerCase()
              .includes(q)
            );

        }


        matches =
          matches.slice(0,6);


        if(!matches.length){

          results.innerHTML =
            '<div class="kaivyra-search-empty">' +
              'No matching content found.' +
            '</div>';

          return;

        }


        results.innerHTML = "";


        matches.forEach(item => {

          const button =
            document.createElement("button");

          button.type = "button";
          button.className =
            "kaivyra-search-result";

          const title =
            document.createElement("span");

          title.className =
            "kaivyra-search-result-title";

          title.textContent =
            item.title;


          const text =
            document.createElement("span");

          text.className =
            "kaivyra-search-result-text";

          text.textContent =
            item.text;


          button.appendChild(title);
          button.appendChild(text);


          button.addEventListener(
            "click",
            function(){

              searchWrap.classList.remove(
                "open"
              );

              item.element.scrollIntoView({
                behavior:"smooth",
                block:"start"
              });

            }
          );


          results.appendChild(button);

        });

      }

    }


    /* =====================================================
       BOLD EN / CURRENT LANGUAGE
       ===================================================== */

    const enCandidate =
      document.querySelector(
        ".header-actions .kaivyra-lang-btn"
      );

    if(enCandidate){
      enCandidate.classList.add(
        "kaivyra-en-nav"
      );
    }


    /* =====================================================
       LANGUAGE SUPPORT
       ===================================================== */

    const translations = {

      en: {
        "About":"About",
        "Focus":"Focus",
        "What We Build":"What We Build",
        "Approach":"Approach",
        "Contact":"Contact"
      },

      hi: {
        "About":"हमारे बारे में",
        "Focus":"मुख्य क्षेत्र",
        "What We Build":"हम क्या बनाते हैं",
        "Approach":"हमारा दृष्टिकोण",
        "Contact":"संपर्क"
      }

    };


    function setLanguage(lang){

      const dict =
        translations[lang] ||
        translations.en;


      document.documentElement.lang =
        lang === "hi" ? "hi" : "en";


      document
        .querySelectorAll(
          ".nav-links .nav-dropdown-btn, .nav-links > a"
        )
        .forEach(el => {

          const key =
            el.dataset.kaivyraOriginal ||
            el.textContent.trim();

          if(!el.dataset.kaivyraOriginal){
            el.dataset.kaivyraOriginal = key;
          }

          el.textContent =
            dict[el.dataset.kaivyraOriginal] ||
            el.dataset.kaivyraOriginal;

        });


      document
        .querySelectorAll(
          ".mobile-panel .mobile-dropdown-btn, .mobile-panel > a"
        )
        .forEach(el => {

          const key =
            el.dataset.kaivyraOriginal ||
            el.textContent.trim();

          if(!el.dataset.kaivyraOriginal){
            el.dataset.kaivyraOriginal = key;
          }

          el.textContent =
            dict[el.dataset.kaivyraOriginal] ||
            el.dataset.kaivyraOriginal;

        });


      document
        .querySelectorAll(
          ".kaivyra-lang-option"
        )
        .forEach(option => {

          option.classList.toggle(
            "active",
            option.dataset.lang === lang
          );

        });


      const current =
        document.querySelector(
          ".kaivyra-current-lang"
        );

      if(current){
        current.textContent =
          lang === "hi" ? "HI" : "EN";
      }


      try{
        localStorage.setItem(
          "kaivyra-language",
          lang
        );
      }catch(e){}

    }


    /* =====================================================
       OUTSIDE CLICK
       ===================================================== */

    document.addEventListener(
      "click",
      function(event){

        const search =
          document.querySelector(
            ".kaivyra-search-wrap"
          );

        const language =
          document.querySelector(
            ".kaivyra-lang-wrap"
          );

        if(
          search &&
          !search.contains(event.target)
        ){
          search.classList.remove("open");
        }

        if(
          language &&
          !language.contains(event.target)
        ){
          language.classList.remove("open");
        }

      }
    );


    /* =====================================================
       RESTORE LANGUAGE
       ===================================================== */

    let savedLanguage = "en";

    try{
      savedLanguage =
        localStorage.getItem(
          "kaivyra-language"
        ) || "en";
    }catch(e){}

    setLanguage(savedLanguage);

  }


  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      initKaivyraNavEnhancements
    );
  }else{
    initKaivyraNavEnhancements();
  }

})();
</script>

<!-- KAIVYRA NAV LANGUAGE + SEARCH v1 END -->
<!-- KAIVYRA ULTRA BOXES START -->
<style>
/* Individual content cards only — page sections untouched */
main .card,
main .feature-card,
main .focus-card,
main .build-card,
main .approach-card,
main .info-card,
main .content-card,
main .feature,
main .focus-item,
main .build-item,
main .approach-item,
main .contact-card,
main .contact-item,
main .explore-card,
main .item-card {
  border: 2px solid #87CEEB !important;
  box-shadow:
    0 0 0 1px rgba(135,206,235,.20),
    0 8px 24px rgba(135,206,235,.16) !important;
  border-radius: 16px !important;
  box-sizing: border-box !important;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease !important;
}

main .card:hover,
main .feature-card:hover,
main .focus-card:hover,
main .build-card:hover,
main .approach-card:hover,
main .info-card:hover,
main .content-card:hover,
main .feature:hover,
main .focus-item:hover,
main .build-item:hover,
main .approach-item:hover,
main .contact-card:hover,
main .contact-item:hover,
main .explore-card:hover,
main .item-card:hover {
  border-color: #4DB8E8 !important;
  box-shadow:
    0 0 0 2px rgba(135,206,235,.18),
    0 12px 30px rgba(135,206,235,.24) !important;
  transform: translateY(-2px);
}
</style>
<!-- KAIVYRA ULTRA BOXES END -->
<!-- KAIVYRA CONTACT LINKS START -->
<style>
.kaivyra-contact-links{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  margin-top:22px;
}

.kaivyra-contact-box{
  display:inline-flex;
  align-items:center;
  gap:11px;
  min-height:52px;
  padding:0 18px;
  border:2px solid #87CEEB;
  border-radius:14px;
  background:rgba(135,206,235,.07);
  color:inherit;
  text-decoration:none;
  box-shadow:
    0 0 0 1px rgba(135,206,235,.16),
    0 8px 22px rgba(135,206,235,.12);
  transition:all .2s ease;
}

.kaivyra-contact-box:hover{
  border-color:#4DB8E8;
  box-shadow:
    0 0 0 2px rgba(135,206,235,.15),
    0 10px 28px rgba(135,206,235,.22);
  transform:translateY(-2px);
}

.kaivyra-contact-box svg{
  width:22px;
  height:22px;
  flex:none;
}

.kaivyra-contact-box span{
  font-weight:600;
  line-height:1.2;
}

@media(max-width:600px){
  .kaivyra-contact-links{
    flex-direction:column;
    align-items:stretch;
  }

  .kaivyra-contact-box{
    width:100%;
    box-sizing:border-box;
  }
}
</style>

<script>
(function(){
  const email = 'the.kaivyra@gmail.com';
  const linkedin = 'https://www.linkedin.com/in/shivam-maurya-7294133b6/';

  function addContactBoxes(){
    const contact = document.querySelector('#contact');
    if(!contact) return;

    if(contact.querySelector('.kaivyra-contact-links')) return;

    const wrap = document.createElement('div');
    wrap.className = 'kaivyra-contact-links';

    const emailBox = document.createElement('a');
    emailBox.className = 'kaivyra-contact-box';
    emailBox.href = 'mailto:' + email;
    emailBox.setAttribute('aria-label','Email KAIVYRA');
    emailBox.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
           aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      <span>${email}</span>
    `;

    const linkedinBox = document.createElement('a');
    linkedinBox.className = 'kaivyra-contact-box';
    linkedinBox.href = linkedin;
    linkedinBox.target = '_blank';
    linkedinBox.rel = 'noopener noreferrer';
    linkedinBox.setAttribute('aria-label','KAIVYRA LinkedIn');
    linkedinBox.innerHTML = `
      <svg viewBox="0 0 24 24" fill="currentColor"
           aria-hidden="true">
        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
        <path fill="white" d="M8 10v6M8 7.5v.01M11 16v-6m0 3
          c0-1.8 1.1-3 2.7-3 1.6 0 2.3 1.1 2.3 3v3"></path>
      </svg>
      <span>LinkedIn</span>
    `;

    wrap.appendChild(emailBox);
    wrap.appendChild(linkedinBox);

    const target =
      contact.querySelector('.contact-content') ||
      contact.querySelector('.contact-inner') ||
      contact.querySelector('.container') ||
      contact;

    target.appendChild(wrap);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', addContactBoxes);
  }else{
    addContactBoxes();
  }
})();
</script>
<!-- KAIVYRA CONTACT LINKS END -->
</body>
</html>




