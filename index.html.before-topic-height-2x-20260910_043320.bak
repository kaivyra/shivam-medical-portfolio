}

.kaivyra-medical-back,
.kaivyra-medical-close{
    border:0;
    background:none;
    color:#102039;
    cursor:pointer;
    font:600 12px 'Poppins',sans-serif;
    display:flex;
    align-items:center;
    gap:9px;
    padding:10px 4px;
}

.kaivyra-medical-back{justify-self:start}
.kaivyra-medical-close{justify-self:end}

.kaivyra-medical-back:hover,
.kaivyra-medical-close:hover{
    color:#0080A8;
}

.kaivyra-medical-intro{
    width:min(100% - 40px,1100px);
    margin:0 auto;
    padding:76px 0 55px;
    text-align:center;
}

.kaivyra-medical-eyebrow{
    display:inline-flex;
    align-items:center;
    gap:9px;
    color:#0080A8;
    font:700 11px 'Poppins',sans-serif;
    letter-spacing:.18em;
}

.kaivyra-medical-eyebrow:before{
    content:"";
