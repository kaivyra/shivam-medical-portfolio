    font-size:15px;
    line-height:1.8;
}

.kaivyra-medical-master-wrap{
    position:relative;
    width:min(100% - 32px,1500px);
    margin:0 auto;
    padding-bottom:80px;
}

.kaivyra-medical-master{
    position:relative;
    z-index:8;
    width:25cm;
    min-width:25cm;
    height:3cm;
    min-height:3cm;
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
    box-sizing:border-box;
    background:#0080A8;
    box-shadow:
        0 18px 45px rgba(0,128,168,.18),
        0 0 0 8px rgba(0,128,168,.045);
}

.kaivyra-medical-master span{
    color:#fff;
    font-family:'Poppins',sans-serif;
    font-size:clamp(22px,3vw,38px);
    line-height:1;
    font-weight:800;
    letter-spacing:-.025em;
    white-space:nowrap;
    text-align:center;
}

.kaivyra-medical-spine{
    position:absolute;
    z-index:1;
    top:3cm;
    bottom:20px;
    left:50%;
    width:5px;
    transform:translateX(-50%);
    background:#0080A8;
    border-radius:5px;
    box-shadow:0 0 18px rgba(0,128,168,.14);
}

.kaivyra-medical-spine-progress{
    position:fixed;
    z-index:30;
    top:68px;
    left:0;
    width:0;
    height:3px;
    background:#0080A8;
}

.kaivyra-medical-topics{
    position:relative;
    z-index:4;
    display:flex;
    flex-direction:column;
    gap:42px;
    margin-top:72px;
    padding-bottom:40px;
}

.kaivyra-medical-topic{
    position:relative;
    width:calc(50% - 78px);
    min-height:210px;
    padding:28px 30px;
    box-sizing:border-box;
    border:1px solid rgba(0,128,168,.16);
    border-radius:20px;
    background:rgba(255,255,255,.97);
    box-shadow:0 15px 45px rgba(16,32,57,.07);
    opacity:0;
    transform:translateY(30px);
    transition:
        opacity .7s ease,
        transform .7s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.kaivyra-medical-topic.is-visible{
    opacity:1;
    transform:none;
}

.kaivyra-medical-topic:nth-child(odd){
    align-self:flex-start;
}

.kaivyra-medical-topic:nth-child(even){
    align-self:flex-end;
}

.kaivyra-medical-topic:after{
    content:"";
    position:absolute;
    top:50%;
    width:78px;
    height:2px;
    background:#0080A8;
    transform:translateY(-50%);
}

.kaivyra-medical-topic:nth-child(odd):after{
    right:-78px;
}

.kaivyra-medical-topic:nth-child(even):after{
    left:-78px;
}

.kaivyra-medical-topic-number{
    position:absolute;
    top:24px;
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:2px solid #0080A8;
    border-radius:50%;
    background:#fff;
    color:#0080A8;
    font:700 11px 'Poppins',sans-serif;
    box-shadow:0 0 0 7px rgba(0,128,168,.07);
}

.kaivyra-medical-topic:nth-child(odd) .kaivyra-medical-topic-number{
    right:-101px;
}

.kaivyra-medical-topic:nth-child(even) .kaivyra-medical-topic-number{
    left:-101px;
}

.kaivyra-medical-topic:hover{
    border-color:rgba(0,128,168,.42);
    box-shadow:
        0 22px 55px rgba(0,128,168,.12),
        0 0 0 5px rgba(0,128,168,.045);
}

.kaivyra-medical-topic-kicker{
    color:#0080A8;
    font:700 10px 'Poppins',sans-serif;
    letter-spacing:.16em;
}

.kaivyra-medical-topic h2{
    margin-top:8px;
    font:700 clamp(20px,2vw,27px)/1.18 'Poppins',sans-serif;
    letter-spacing:-.02em;
}

.kaivyra-medical-topic p{
    margin-top:11px;
    color:#617084;
    font-size:13px;
    line-height:1.72;
}

.kaivyra-medical-depth{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin-top:18px;
}

.kaivyra-medical-depth span{
    padding:6px 9px;
    border:1px solid rgba(0,128,168,.13);
    border-radius:999px;
    background:#f3f9fa;
    color:#31566a;
    font-size:10px;
    font-weight:600;
}

.kaivyra-medical-footer-note{
    width:min(100% - 40px,1100px);
    margin:0 auto;
    padding:30px 0 80px;
    display:flex;
    justify-content:space-between;
    gap:20px;
    color:#718092;
    font-size:10px;
    line-height:1.6;
    letter-spacing:.08em;
    text-transform:uppercase;
}

.kaivyra-medical-footer-note span:first-child{
    color:#0080A8;
    font-weight:700;
}

body.kaivyra-medical-explore-active{
    overflow:hidden;
}

@media(max-width:900px){

    .kaivyra-medical-master{
        width:calc(100% - 20px);
        min-width:0;
        height:88px;
        min-height:88px;
    }

    .kaivyra-medical-master span{
        white-space:normal;
        font-size:24px;
        padding:0 20px;
    }

    .kaivyra-medical-spine{
        top:88px;
        left:24px;
        transform:none;
    }

    .kaivyra-medical-topics{
        gap:24px;
        margin-top:55px;
        padding-left:58px;
    }

    .kaivyra-medical-topic,
    .kaivyra-medical-topic:nth-child(odd),
    .kaivyra-medical-topic:nth-child(even){
        width:100%;
        align-self:stretch;
    }

    .kaivyra-medical-topic:after{
        left:-34px !important;
        right:auto !important;
        width:34px;
    }

    .kaivyra-medical-topic-number,
    .kaivyra-medical-topic:nth-child(odd) .kaivyra-medical-topic-number,
    .kaivyra-medical-topic:nth-child(even) .kaivyra-medical-topic-number{
        left:-55px;
        right:auto;
        top:25px;
    }

    .kaivyra-medical-footer-note{
        flex-direction:column;
    }
}

@media(max-width:620px){

    .kaivyra-medical-header{
        min-height:60px;
        padding:0 16px;
    }

    .kaivyra-medical-header-title{
        font-size:9px;
    }

    .kaivyra-medical-intro{
        width:calc(100% - 30px);
        padding:55px 0 42px;
    }

    .kaivyra-medical-intro h1{
        font-size:32px;
    }

    .kaivyra-medical-intro p{
        font-size:13px;
    }

    .kaivyra-medical-master-wrap{
        width:calc(100% - 24px);
    }

    .kaivyra-medical-topic{
        padding:23px 20px;
        border-radius:17px;
    }

    .kaivyra-medical-topic h2{
        font-size:19px;
    }

    .kaivyra-medical-topic p{
        font-size:12px;
    }
}

@media(prefers-reduced-motion:reduce){

    #kaivyra-medical-explore-view *,
    #kaivyra-medical-explore-view{
        scroll-behavior:auto !important;
        transition:none !important;
    }

    .kaivyra-medical-topic{
        opacity:1;
        transform:none;
    }
}
</style>
<script id="kaivyra-medical-explore-script">
(function(){

    "use strict";

    var view = document.getElementById("kaivyra-medical-explore-view");

    if(!view){
        return;
    }

    var shell = view.querySelector(".kaivyra-medical-shell");
    var progress = view.querySelector(".kaivyra-medical-spine-progress");
    var triggers = document.querySelectorAll("[data-kaivyra-medical-explore]");
    var closeButtons = view.querySelectorAll("[data-kaivyra-medical-close]");
    var topics = view.querySelectorAll(".kaivyra-medical-topic");

    var previousScrollY = 0;
    var isOpen = false;

    function updateProgress(){

        if(!shell || !progress){
            return;
        }

        var maxScroll = shell.scrollHeight - shell.clientHeight;

        if(maxScroll <= 0){
            progress.style.width = "0%";
            return;
        }

        var ratio = shell.scrollTop / maxScroll;

        ratio = Math.max(0,Math.min(1,ratio));

        progress.style.width = (ratio * 100) + "%";
    }

    function revealTopics(){

        if(!("IntersectionObserver" in window)){

            for(var i=0;i<topics.length;i++){
                topics[i].classList.add("is-visible");
            }

            return;
        }

        var observer = new IntersectionObserver(function(entries){

            entries.forEach(function(entry){

                if(entry.isIntersecting){
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }

            });

        },{
            root:shell,
            threshold:.12
        });

        for(var i=0;i<topics.length;i++){
            observer.observe(topics[i]);
        }
    }

    function openMedicalExplore(){

        if(isOpen){
            return;
        }

        previousScrollY = window.scrollY || window.pageYOffset || 0;

        isOpen = true;

        view.classList.add("is-open");
        view.setAttribute("aria-hidden","false");
        document.body.classList.add("kaivyra-medical-explore-active");

        if(window.location.hash !== "#medical-science"){
            history.pushState(
                {kaivyraMedicalExplore:true},
                "",
                "#medical-science"
            );
        }

        if(shell){
            shell.scrollTop = 0;
        }

        updateProgress();
        revealTopics();

        var mobilePanel = document.getElementById("mobilePanel");

        if(mobilePanel){
            mobilePanel.classList.remove("open");
        }
    }

    function closeMedicalExplore(removeHash){

        if(!isOpen){
            return;
        }

        isOpen = false;

        view.classList.remove("is-open");
        view.setAttribute("aria-hidden","true");
        document.body.classList.remove("kaivyra-medical-explore-active");

        if(removeHash && window.location.hash === "#medical-science"){

            history.replaceState(
                null,
                "",
                window.location.pathname + window.location.search
            );
        }

        window.scrollTo(0,previousScrollY);
    }

    for(var i=0;i<triggers.length;i++){

        triggers[i].addEventListener("click",function(event){

            event.preventDefault();
            openMedicalExplore();

        });

        triggers[i].addEventListener("keydown",function(event){

            if(event.key === "Enter" || event.key === " "){

                event.preventDefault();
                openMedicalExplore();

            }

        });
    }

    for(var j=0;j<closeButtons.length;j++){

        closeButtons[j].addEventListener("click",function(){

            closeMedicalExplore(true);

        });
    }

    if(shell){

        shell.addEventListener(
            "scroll",
            updateProgress,
            {passive:true}
        );

    }

    document.addEventListener("keydown",function(event){

        if(event.key === "Escape" && isOpen){
            closeMedicalExplore(true);
        }

    });

    window.addEventListener("popstate",function(){

        if(window.location.hash === "#medical-science"){

            if(!isOpen){
                openMedicalExplore();
            }

        }else if(isOpen){

            closeMedicalExplore(false);

        }

    });

    if(window.location.hash === "#medical-science"){
        openMedicalExplore();
    }

})();
</script>
<script id="kaivyra-medical-topic-clickable-patch">
/* ============================================================
   KAIVYRA MEDICAL EXPLORE — FULL TOPIC CLICK BEHAVIOUR
   ============================================================ */
(function () {
    "use strict";

    function initKaivyraMedicalTopics() {
        var view = document.getElementById("kaivyra-medical-explore-view");

        if (!view) {
            return;
        }

        var topics = view.querySelectorAll(".kaivyra-medical-topic");

        if (!topics.length) {
            return;
        }

        topics.forEach(function (topic) {

            if (topic.dataset.kaivyraClickable === "true") {
                return;
            }

            topic.dataset.kaivyraClickable = "true";

            /* Accessibility */
            if (!topic.hasAttribute("tabindex")) {
                topic.setAttribute("tabindex", "0");
            }

            topic.setAttribute("role", "button");

            var topicNumber = topic.getAttribute("data-topic");

            if (topicNumber) {
                topic.setAttribute(
                    "aria-label",
                    "Open medical science topic " + topicNumber
                );
            }

            function activateTopic() {

                topics.forEach(function (item) {
                    item.classList.remove("is-active");
                });

                topic.classList.add("is-active");

                /*
                 * Keep the topic itself as the click target.
                 * Do not modify existing content or nested controls.
                 */
                try {
                    topic.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                } catch (e) {
                    topic.scrollIntoView();
                }
            }

            topic.addEventListener("click", function (event) {

                /*
                 * If a future topic contains an actual interactive
                 * element, let that element behave normally.
                 */
                var interactive = event.target.closest(
                    "a, button, input, select, textarea, summary"
                );

                if (interactive && interactive !== topic) {
                    return;
                }

                activateTopic();
            });

            topic.addEventListener("keydown", function (event) {

                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    activateTopic();
                }
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initKaivyraMedicalTopics,
            { once: true }
        );
    } else {
        initKaivyraMedicalTopics();
    }

    /*
     * Existing Medical Explore view is dynamically opened,
     * so initialize again whenever the view becomes visible.
     */
    document.addEventListener("click", function (event) {

        var trigger = event.target.closest(
            '[data-kaivyra-medical-explore]'
        );

        if (trigger) {
            window.setTimeout(initKaivyraMedicalTopics, 50);
        }
    });

})();
</script>
</body>
</html>






