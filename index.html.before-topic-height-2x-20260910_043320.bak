    height:7px;
    border-radius:50%;
    background:#0080A8;
    box-shadow:0 0 0 6px rgba(0,128,168,.10);
}

.kaivyra-medical-intro h1{
    max-width:950px;
    margin:15px auto 0;
    font:700 clamp(32px,5vw,58px)/1.08 'Poppins',sans-serif;
    letter-spacing:-.035em;
}

.kaivyra-medical-intro p{
    max-width:760px;
    margin:22px auto 0;
