<script>
(function(){
  function addContactBoxes(){
    const contact = document.querySelector('#contact');
    if(!contact || contact.querySelector('.kaivyra-contact-links')) return;

    const wrap = document.createElement('div');
    wrap.className = 'kaivyra-contact-links';

    wrap.innerHTML = `
      <a class="kaivyra-contact-box"
         href="mailto:the.kaivyra@gmail.com"
         aria-label="Email KAIVYRA">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <span>the.kaivyra@gmail.com</span>
      </a>

      <a class="kaivyra-contact-box"
         href="https://www.linkedin.com/in/shivam-maurya-7294133b6/"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <rect x="4" y="4" width="16" height="16" rx="2"></rect>
          <path fill="white"
                d="M8 10v6M8 7.5v.01M11 16v-6m0 3
                   c0-1.8 1.1-3 2.7-3 1.6 0 2.3 1.1 2.3 3v3"></path>
        </svg>
        <span>LinkedIn</span>
      </a>
    `;

    /* Contact section ke bilkul bottom mein */
    contact.appendChild(wrap);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', addContactBoxes);
  }else{
    addContactBoxes();
  }
})();
</script>
<!-- KAIVYRA CONTACT LINKS END -->
