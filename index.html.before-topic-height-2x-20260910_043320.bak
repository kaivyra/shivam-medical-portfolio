<!-- KAIVYRA BUILD JS START -->

<script id="kaivyra-build-system-js">

(function(){

  const view =
    document.getElementById("kaivyra-build-view");

  const detailGrid =
    document.getElementById("kaivyra-detail-grid");

  const title =
    document.getElementById("kaivyra-build-title");

  const description =
    document.getElementById("kaivyra-build-description");

  const number =
    document.getElementById("kaivyra-build-number");

  const headerCategory =
    document.getElementById(
      "kaivyra-build-header-category"
    );

  const backButton =
    document.getElementById(
      "kaivyra-build-back"
    );

  const closeButton =
    document.getElementById(
      "kaivyra-build-close"
    );


  if(
    !view ||
    !detailGrid ||
    !title ||
    !description ||
    !number
  ){

    console.warn(
      "KAIVYRA build system: required elements missing."
    );

    return;

  }


  const buildData = {

    "digital-products":{
      number:"01",
      title:"Digital Products",
      description:
        "Digital experiences designed around access, communication, information and practical healthcare workflows.",
      items:[
        ["01","Patient Access & Self-Service","Clear digital pathways that help people find, understand and use healthcare services."],
        ["02","Appointment & Care Navigation","Tools that make scheduling, navigation and next-step decisions easier."],
        ["03","Records & Health Information","Patient-facing systems for structured access to relevant health information."],
        ["04","Communication & Follow-up","Thoughtful digital communication for reminders, follow-up and continuity."],
        ["05","Benefits, Billing & Affordability","Experiences that help people understand costs, coverage and available support."],
        ["06","Accessible & Multilingual Experience","Inclusive interfaces designed for different abilities, languages and contexts."]
      ]
    },


    "intelligent-systems":{
      number:"02",
      title:"Intelligent Systems",
      description:
        "AI-assisted systems designed to help people work with knowledge, information, decisions and complex processes.",
      items:[
        ["01","Clinical Intelligence","Decision-support concepts that organize relevant information around clinical workflows."],
        ["02","Medical Knowledge AI","Knowledge systems that help users discover, understand and work with medical information."],
        ["03","Workflow Automation","Intelligent automation for repetitive information-heavy healthcare processes."],
        ["04","Document Intelligence","Systems that structure, extract and reason over complex healthcare documents."],
        ["05","Predictive & Risk Intelligence","Analytical systems for identifying patterns, trends and potential areas of risk."],
        ["06","Operational Decision Support","Tools that turn operational data into clearer choices and actionable insight."]
      ]
    },


    "research-tools":{
      number:"03",
      title:"Research Tools",
      description:
        "Research-oriented systems for evidence discovery, health data, study workflows, visualization and better decisions.",
      items:[
        ["01","Evidence Discovery","Tools for finding, organizing and comparing relevant scientific and medical evidence."],
        ["02","Health Data Analytics","Structured analysis of healthcare and population data for useful insights."],
        ["03","Study & Survey Workspaces","Digital environments for designing, managing and reviewing research activities."],
        ["04","Research Documentation","Systems that make research notes, methods, sources and findings easier to manage."],
        ["05","Visualization & Insight","Clear visual interfaces for understanding complex datasets and relationships."],
        ["06","Evidence-to-Decision","Tools that help translate research findings into structured decisions and action."]
      ]
    },


    "healthcare-solutions":{
      number:"04",
      title:"Healthcare Solutions",
      description:
        "Practical healthcare concepts focused on access, continuity, diagnostics, coordination, affordability and connected care.",
      items:[
        ["01","Primary & Preventive Care","Digital approaches supporting prevention, early action and primary healthcare access."],
        ["02","Chronic Care & Continuity","Systems designed to support long-term care journeys and continuity."],
        ["03","Diagnostics & Screening","Technology concepts for clearer screening, diagnostic pathways and follow-up."],
        ["04","Referral & Care Coordination","Tools that connect people, providers, information and next steps across care pathways."],
        ["05","Remote & Connected Care","Digital systems exploring more accessible and connected models of care."],
        ["06","Access, Affordability & Equity","Solutions focused on reducing practical barriers to meaningful healthcare access."]
      ]
    },


    "education-platforms":{
      number:"05",
      title:"Education Platforms",
      description:
        "Learning systems for medical education, clinical skills, assessment, case-based learning and continuing development.",
      items:[
        ["01","Medical Learning","Structured digital environments for learning medical concepts and knowledge."],
        ["02","Clinical Skills","Tools for practicing, organizing and reinforcing clinical reasoning and skills."],
        ["03","Assessment & Exam Preparation","Focused systems for assessment, revision and evidence-based exam preparation."],
        ["04","Case-based Learning","Interactive learning around realistic clinical cases and decision pathways."],
        ["05","Medical Knowledge Library","Organized access to useful educational resources and reference material."],
        ["06","Professional & Continuing Education","Learning systems supporting ongoing development beyond formal education."]
      ]
    },


    "experimental-projects":{
      number:"06",
      title:"Experimental Projects",
      description:
        "Early concepts exploring new interfaces, human-AI interaction, MedTech ideas, data experiments and future care models.",
      items:[
        ["01","Digital Health Prototypes","Early-stage concepts exploring new digital approaches to health and care."],
        ["02","Human-AI Interaction","Experiments around useful, transparent and human-centered AI interfaces."],
        ["03","New Care Models","Exploration of alternative ways technology could support future healthcare delivery."],
        ["04","MedTech Concepts","Early technology concepts at the intersection of medicine, engineering and product design."],
        ["05","Health Data Experiments","Small-scale experiments around health information, structure, analysis and insight."],
        ["06","Future Care Interfaces","Conceptual interfaces exploring how people may interact with healthcare systems in the future."]
      ]
    }

  };


  let previousScrollY = 0;


  function getKeyFromHash(){

    const hash =
      window.location.hash || "";

    if(
      hash.indexOf("#build-") !== 0
    ){
      return null;
    }

    const key =
      hash.substring(7);

    return buildData[key]
      ? key
      : null;

  }


  function renderCategory(key){

    const data =
      buildData[key];

    if(!data) return;


    number.textContent =
      data.number;

    title.textContent =
      data.title;

    description.textContent =
      data.description;


    if(headerCategory){

      headerCategory.textContent =
        data.title;

    }


    detailGrid.innerHTML = "";


    data.items.forEach(function(item){

      const card =
        document.createElement("article");

      card.className =
        "kaivyra-detail-card";


      const n =
        document.createElement("span");

      n.className =
        "kaivyra-detail-card-number";

      n.textContent =
        item[0];


      const h =
        document.createElement("h3");

      h.textContent =
        item[1];


      const p =
        document.createElement("p");

      p.textContent =
        item[2];


      const mark =
        document.createElement("span");

      mark.className =
        "kaivyra-detail-card-mark";

      mark.textContent =
        "↗";


      card.appendChild(n);
      card.appendChild(h);
      card.appendChild(p);
      card.appendChild(mark);


      detailGrid.appendChild(card);

    });

  }


  function openBuild(
    key,
    updateHistory
  ){

    if(!buildData[key]) return;


    previousScrollY =
      window.scrollY ||
      window.pageYOffset ||
      0;


    renderCategory(key);


    view.classList.add(
      "is-open"
    );

    view.setAttribute(
      "aria-hidden",
      "false"
    );


    document.documentElement.classList.add(
      "kaivyra-build-active"
    );

    document.body.classList.add(
      "kaivyra-build-active"
    );


    view.scrollTop = 0;


    if(updateHistory){

      history.pushState(
        {
          kaivyraBuild:key
        },
        "",
        "#build-" + key
      );

    }

  }


  function closeBuild(
    updateHistory
  ){

    view.classList.remove(
      "is-open"
    );

    view.setAttribute(
      "aria-hidden",
      "true"
    );


    document.documentElement.classList.remove(
      "kaivyra-build-active"
    );

    document.body.classList.remove(
      "kaivyra-build-active"
    );


    if(updateHistory){

      history.pushState(
        {},
        "",
        window.location.pathname +
        window.location.search
      );

    }


    window.scrollTo(
      0,
      previousScrollY
    );

  }


  document
    .querySelectorAll(
      "[data-build-category]"
    )
    .forEach(function(card){

      card.addEventListener(
        "click",
        function(){

          const key =
            this.getAttribute(
              "data-build-category"
            );

          openBuild(
            key,
            true
          );

        }
      );

    });


  if(backButton){

    backButton.addEventListener(
      "click",
      function(){

        closeBuild(true);

      }
    );

  }


  if(closeButton){

    closeButton.addEventListener(
      "click",
      function(){

        closeBuild(true);

      }
    );

  }


  window.addEventListener(
    "popstate",
    function(){

      const key =
        getKeyFromHash();


      if(key){

        openBuild(
          key,
          false
        );

      }else if(
        view.classList.contains(
          "is-open"
        )
      ){

        closeBuild(false);

      }

    }
  );


  document.addEventListener(
    "keydown",
    function(event){

      if(
        event.key === "Escape" &&
        view.classList.contains(
          "is-open"
        )
      ){

        closeBuild(true);

      }

    }
  );


  const initialKey =
    getKeyFromHash();


  if(initialKey){

    openBuild(
      initialKey,
      false
    );

  }

})();

</script>

<!-- KAIVYRA BUILD JS END -->
<style id="kaivyra-medical-explore-style">
#kaivyra-medical-explore-view{
    position:fixed;
    inset:0;
    z-index:99990;
    display:none;
    overflow:hidden;
    background:
        radial-gradient(circle at 50% 0%,rgba(0,128,168,.10),transparent 32%),
        #f7fbfc;
    color:#102039;
}

#kaivyra-medical-explore-view.is-open{
    display:block;
}

.kaivyra-medical-shell{
    width:100%;
    height:100%;
    overflow-y:auto;
    overflow-x:hidden;
    scroll-behavior:smooth;
}

.kaivyra-medical-header{
    position:sticky;
    top:0;
    z-index:20;
    min-height:68px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    gap:20px;
    padding:0 30px;
    border-bottom:1px solid rgba(16,32,57,.10);
    background:rgba(247,251,252,.94);
    backdrop-filter:blur(18px);
}

.kaivyra-medical-header-title{
    font-family:'Poppins',sans-serif;
    font-size:12px;
    font-weight:700;
