    gap:14px;

    padding-left:2px;
    padding-right:2px;
  }

}

/* KAIVYRA 36 BUILD BOXES END */
</style>

<script>
(function(){

  function initKaivyraNavEnhancements(){

    const headerActions =
      document.querySelector(".header-actions");

    if(!headerActions) return;


    /* =====================================================
       FIND EXISTING EN CONTROL
       ===================================================== */

    let oldLang =
      headerActions.querySelector(".lang");

    if(oldLang){

      oldLang.classList.add("kaivyra-old-lang");

      const langWrap =
        document.createElement("div");

      langWrap.className =
        "kaivyra-lang-wrap";


      const langBtn =
        document.createElement("button");

      langBtn.type = "button";
      langBtn.className = "kaivyra-lang-btn";
      langBtn.setAttribute(
        "aria-label",
        "Choose language"
      );

      langBtn.innerHTML =
        '<span class="kaivyra-current-lang">EN</span>' +
        '<span class="kaivyra-lang-chevron"></span>';


      const langMenu =
        document.createElement("div");

      langMenu.className =
        "kaivyra-lang-menu";

      langMenu.innerHTML =

        '<button type="button" class="kaivyra-lang-option active" data-lang="en">' +
          'English' +
        '</button>' +

        '<button type="button" class="kaivyra-lang-option" data-lang="hi">' +
          'हिन्दी' +
        '</button>';


      langWrap.appendChild(langBtn);
      langWrap.appendChild(langMenu);

      oldLang.replaceWith(langWrap);


      langBtn.addEventListener("click", function(event){

        event.stopPropagation();

        const open =
          langWrap.classList.toggle("open");

        searchWrap &&
          searchWrap.classList.remove("open");

      });


      langMenu
        .querySelectorAll(".kaivyra-lang-option")
        .forEach(option => {

          option.addEventListener("click", function(){

            const lang =
              this.getAttribute("data-lang");

            setLanguage(lang);

            langWrap.classList.remove("open");

          });

        });

    }


    /* =====================================================
       COMPACT SEARCH
       ===================================================== */

    let searchWrap =
      headerActions.querySelector(".kaivyra-search-wrap");

    if(!searchWrap){

      searchWrap =
        document.createElement("div");

      searchWrap.className =
        "kaivyra-search-wrap";


      const searchBtn =
        document.createElement("button");

      searchBtn.type = "button";
      searchBtn.className =
        "kaivyra-search-btn";

      searchBtn.setAttribute(
        "aria-label",
        "Search KAIVYRA"
      );

      searchBtn.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
          '<circle cx="11" cy="11" r="6.5"></circle>' +
          '<line x1="16" y1="16" x2="21" y2="21"></line>' +
        '</svg>';


      const panel =
        document.createElement("div");

      panel.className =
        "kaivyra-search-panel";

      panel.innerHTML =
        '<div class="kaivyra-search-input-row">' +
          '<input class="kaivyra-search-input" type="search" autocomplete="off" placeholder="Search KAIVYRA..." aria-label="Search website">' +
        '</div>' +
        '<div class="kaivyra-search-results"></div>';


      searchWrap.appendChild(searchBtn);
      searchWrap.appendChild(panel);


      /*
         Existing header icon is the old search/explore icon.
         Replace it instead of creating a duplicate.
      */

      const existingIcon =
        headerActions.querySelector(
          '.header-icon:not(.lang)'
        );

      if(existingIcon){
        existingIcon.replaceWith(searchWrap);
      }else{
        headerActions.insertBefore(
          searchWrap,
          headerActions.firstChild
        );
      }


      const input =
        panel.querySelector(
          ".kaivyra-search-input"
        );

      const results =
        panel.querySelector(
          ".kaivyra-search-results"
        );


      searchBtn.addEventListener(
        "click",
        function(event){

          event.stopPropagation();

          const open =
            searchWrap.classList.toggle("open");

          document
            .querySelectorAll(".kaivyra-lang-wrap")
            .forEach(x =>
              x.classList.remove("open")
            );

          if(open){

            setTimeout(
              () => input.focus(),
              50
            );

            renderSearchResults("");

          }

        }
      );


      input.addEventListener(
        "input",
        function(){

          renderSearchResults(
            input.value.trim()
          );

        }
      );


      input.addEventListener(
        "keydown",
        function(event){

          if(event.key === "Escape"){

            searchWrap.classList.remove(
              "open"
            );

            input.blur();

          }

        }
      );


      function renderSearchResults(query){

        const sections =
          Array.from(
            document.querySelectorAll(
              "main section, main [id]"
            )
          );

        const unique = [];

        sections.forEach(element => {

          if(
            unique.includes(element) ||
            element.closest(".kaivyra-search-panel")
          ) return;

          if(!element.id) return;

          const heading =
            element.querySelector(
              "h1,h2,h3"
            );

          const title =
            heading
              ? heading.textContent.trim()
              : element.id;

          const text =
            element.textContent
              .replace(/\s+/g," ")
              .trim();

          if(!text) return;

          unique.push({
            element,
            title,
            text
          });

        });


        let matches = unique;


        if(query){

          const q =
            query.toLowerCase();

          matches =
            unique.filter(item =>
              (
                item.title + " " + item.text
              )
              .toLowerCase()
              .includes(q)
            );

        }


        matches =
          matches.slice(0,6);


        if(!matches.length){

          results.innerHTML =
            '<div class="kaivyra-search-empty">' +
              'No matching content found.' +
            '</div>';

          return;

        }


        results.innerHTML = "";


        matches.forEach(item => {

          const button =
            document.createElement("button");

          button.type = "button";
          button.className =
            "kaivyra-search-result";

          const title =
            document.createElement("span");

          title.className =
            "kaivyra-search-result-title";

          title.textContent =
            item.title;


          const text =
            document.createElement("span");

          text.className =
            "kaivyra-search-result-text";

          text.textContent =
            item.text;


          button.appendChild(title);
          button.appendChild(text);


          button.addEventListener(
            "click",
            function(){

              searchWrap.classList.remove(
                "open"
              );

              item.element.scrollIntoView({
                behavior:"smooth",
                block:"start"
              });

            }
          );


          results.appendChild(button);

        });

      }

    }


    /* =====================================================
       BOLD EN / CURRENT LANGUAGE
       ===================================================== */

    const enCandidate =
      document.querySelector(
        ".header-actions .kaivyra-lang-btn"
      );

    if(enCandidate){
      enCandidate.classList.add(
        "kaivyra-en-nav"
      );
    }


    /* =====================================================
       LANGUAGE SUPPORT
       ===================================================== */

    const translations = {

      en: {
        "About":"About",
        "Focus":"Focus",
        "What We Build":"What We Build",
        "Approach":"Approach",
        "Contact":"Contact"
      },

      hi: {
        "About":"हमारे बारे में",
        "Focus":"मुख्य क्षेत्र",
        "What We Build":"हम क्या बनाते हैं",
        "Approach":"हमारा दृष्टिकोण",
        "Contact":"संपर्क"
      }

    };


    function setLanguage(lang){

      const dict =
        translations[lang] ||
        translations.en;


      document.documentElement.lang =
        lang === "hi" ? "hi" : "en";


      document
        .querySelectorAll(
          ".nav-links .nav-dropdown-btn, .nav-links > a"
        )
        .forEach(el => {

          const key =
            el.dataset.kaivyraOriginal ||
            el.textContent.trim();

          if(!el.dataset.kaivyraOriginal){
            el.dataset.kaivyraOriginal = key;
          }

          el.textContent =
            dict[el.dataset.kaivyraOriginal] ||
            el.dataset.kaivyraOriginal;

        });


      document
        .querySelectorAll(
          ".mobile-panel .mobile-dropdown-btn, .mobile-panel > a"
        )
        .forEach(el => {

          const key =
            el.dataset.kaivyraOriginal ||
            el.textContent.trim();

          if(!el.dataset.kaivyraOriginal){
            el.dataset.kaivyraOriginal = key;
          }

          el.textContent =
            dict[el.dataset.kaivyraOriginal] ||
            el.dataset.kaivyraOriginal;

        });


      document
        .querySelectorAll(
          ".kaivyra-lang-option"
        )
        .forEach(option => {

          option.classList.toggle(
            "active",
            option.dataset.lang === lang
          );

        });


      const current =
        document.querySelector(
          ".kaivyra-current-lang"
        );

      if(current){
        current.textContent =
          lang === "hi" ? "HI" : "EN";
      }


      try{
        localStorage.setItem(
          "kaivyra-language",
          lang
        );
      }catch(e){}

    }


    /* =====================================================
       OUTSIDE CLICK
       ===================================================== */

    document.addEventListener(
      "click",
      function(event){

        const search =
          document.querySelector(
            ".kaivyra-search-wrap"
          );

        const language =
          document.querySelector(
            ".kaivyra-lang-wrap"
          );

        if(
          search &&
          !search.contains(event.target)
        ){
          search.classList.remove("open");
        }

        if(
          language &&
          !language.contains(event.target)
        ){
          language.classList.remove("open");
        }

      }
    );


    /* =====================================================
       RESTORE LANGUAGE
       ===================================================== */

    let savedLanguage = "en";

    try{
      savedLanguage =
        localStorage.getItem(
          "kaivyra-language"
        ) || "en";
    }catch(e){}

    setLanguage(savedLanguage);

  }


  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      initKaivyraNavEnhancements
    );
  }else{
    initKaivyraNavEnhancements();
  }

})();
</script>

<!-- KAIVYRA NAV LANGUAGE + SEARCH v1 END -->
<!-- KAIVYRA ULTRA BOXES START -->
<style>
/* Individual content cards only — page sections untouched */
main .card,
main .feature-card,
main .focus-card,
main .build-card,
main .approach-card,
main .info-card,
main .content-card,
main .feature,
main .focus-item,
main .build-item,
main .approach-item,
main .contact-card,
main .contact-item,
main .explore-card,
main .item-card {
  border: 2px solid #87CEEB !important;
  box-shadow:
    0 0 0 1px rgba(135,206,235,.20),
    0 8px 24px rgba(135,206,235,.16) !important;
  border-radius: 16px !important;
  box-sizing: border-box !important;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease !important;
}

main .card:hover,
main .feature-card:hover,
main .focus-card:hover,
main .build-card:hover,
main .approach-card:hover,
main .info-card:hover,
main .content-card:hover,
main .feature:hover,
main .focus-item:hover,
main .build-item:hover,
main .approach-item:hover,
main .contact-card:hover,
main .contact-item:hover,
main .explore-card:hover,
main .item-card:hover {
  border-color: #4DB8E8 !important;
  box-shadow:
    0 0 0 2px rgba(135,206,235,.18),
    0 12px 30px rgba(135,206,235,.24) !important;
  transform: translateY(-2px);
}
/* KAIVYRA 36 BUILD BOXES START */

.kaivyra-building-section{
  overflow:hidden;
}

.build-category{
  margin-top:58px;
}

.build-category:first-of-type{
  margin-top:0;
}

.build-category-head{
  display:flex;
  align-items:flex-start;
  gap:18px;
  margin-bottom:22px;
}

.build-category-number{
  flex:0 0 auto;

  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  border:1px solid rgba(56,189,248,.55);
  border-radius:14px;

  color:#0284c7;
  background:linear-gradient(
    145deg,
    #f0f9ff,
    #ffffff
  );

  box-shadow:
    0 0 0 4px rgba(56,189,248,.06),
    0 10px 25px rgba(14,116,144,.08);

  font-family:'Poppins',sans-serif;
  font-size:12px;
  font-weight:700;
}

.build-category-head h3{
  font-size:22px;
  line-height:1.25;
  font-weight:600;
  color:var(--ink);
}

.build-category-head p{
  max-width:680px;
  margin-top:5px;

  color:var(--muted);
  font-size:13px;
  line-height:1.65;
}


/* EXACT 10cm × 10cm CARDS */

.build-ultra-grid{
  display:grid;

  grid-template-columns:repeat(3, 10cm);

  justify-content:center;

  gap:18px;

  padding:8px 4px 12px;

  overflow-x:auto;
  scrollbar-width:thin;
}

.build-ultra-card{
  position:relative;

  width:10cm;
  height:10cm;

  min-width:10cm;
  min-height:10cm;

  box-sizing:border-box;

  padding:28px;

  display:flex;
  flex-direction:column;

  border:2px solid #38bdf8;
  border-radius:22px;

  background:
    radial-gradient(
      circle at 88% 8%,
      rgba(56,189,248,.13),
      transparent 32%
    ),
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f8fcff 100%
    );

  box-shadow:
    0 0 0 1px rgba(56,189,248,.08),
    0 12px 32px rgba(14,116,144,.10),
    inset 0 0 35px rgba(56,189,248,.025);

  overflow:hidden;

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.build-ultra-card::before{
  content:"";

  position:absolute;

  inset:7px;

  border:1px solid rgba(56,189,248,.13);
  border-radius:16px;

  pointer-events:none;
}

.build-ultra-card::after{
  content:"";

  position:absolute;

  width:100px;
  height:100px;

  right:-48px;
  top:-48px;

  border-radius:50%;

  background:rgba(56,189,248,.10);

  pointer-events:none;
}

.build-ultra-card:hover{
  transform:translateY(-7px);

  border-color:#0ea5e9;

  box-shadow:
    0 0 0 3px rgba(56,189,248,.10),
    0 22px 50px rgba(14,116,144,.17),
    0 0 28px rgba(56,189,248,.12);
}

.build-card-number{
  position:relative;
  z-index:2;

  color:#0284c7;

  font-size:11px;
  font-weight:700;
  letter-spacing:.1em;
}

.build-card-icon{
  position:relative;
  z-index:2;

  width:50px;
  height:50px;

  margin-top:25px;

  display:flex;
  align-items:center;
  justify-content:center;

  border:1px solid rgba(56,189,248,.38);
  border-radius:15px;

  color:#0284c7;

  background:
    linear-gradient(
      145deg,
      #e0f2fe,
      #f0f9ff
    );

  box-shadow:
    0 8px 22px rgba(14,116,144,.10);

  font-family:'Poppins',sans-serif;
  font-size:14px;
  font-weight:700;
}

.build-ultra-card h4{
  position:relative;
  z-index:2;

  margin-top:21px;

  color:var(--ink);

  font-family:'Poppins',sans-serif;

  font-size:17px;
  line-height:1.3;
  font-weight:600;
}

.build-ultra-card p{
  position:relative;
  z-index:2;

  margin-top:9px;

  color:var(--muted);

  font-size:12.5px;
  line-height:1.65;
}


/* Tablet */

@media(max-width:1200px){

  .build-ultra-grid{
    grid-template-columns:repeat(2, 10cm);
  }

}


/* Mobile keeps cards EXACTLY 10cm × 10cm */

@media(max-width:760px){

  .build-category{
    margin-top:45px;
  }

  .build-category-head{
    gap:13px;
  }

  .build-category-head h3{
    font-size:19px;
  }

  .build-category-head p{
    font-size:12.5px;
  }

  .build-ultra-grid{
    justify-content:start;

    grid-template-columns:10cm;

    gap:14px;

    padding-left:2px;
    padding-right:2px;
  }

}

