<!-- =========================================================
     KAIVYRA MEDICAL EXPLORE SYSTEM START
     ========================================================= -->

<section
    id="kaivyra-medical-explore-view"
    class="kaivyra-medical-explore-view"
    aria-hidden="true"
    aria-label="The Full Spectrum of Medical Science"
>
    <div class="kaivyra-medical-shell">

        <header class="kaivyra-medical-header">

            <button
                type="button"
                class="kaivyra-medical-back"
                data-kaivyra-medical-close
                aria-label="Back to KAIVYRA"
            >
                <span aria-hidden="true">←</span>
                <span>Back</span>
            </button>

            <div class="kaivyra-medical-header-title">
                KAIVYRA MEDICAL SCIENCE
            </div>

            <button
                type="button"
                class="kaivyra-medical-close"
                data-kaivyra-medical-close
                aria-label="Close medical science exploration"
            >
                <span>Close</span>
                <span aria-hidden="true">×</span>
            </button>

        </header>

        <div class="kaivyra-medical-intro">

            <div class="kaivyra-medical-eyebrow">
                FULL-SPECTRUM EXPLORATION
            </div>

            <h1>
                From the human being to the future of medicine.
            </h1>

            <p>
                A structured way to investigate any disease, medical field,
                patient population or healthcare challenge — from biology
                and evidence to access, systems, innovation and global impact.
            </p>

        </div>

        <div class="kaivyra-medical-master-wrap">

            <div class="kaivyra-medical-master">
                <span>The Full Spectrum of Medical Science</span>
            </div>

            <div class="kaivyra-medical-spine" aria-hidden="true"></div>
            <div class="kaivyra-medical-spine-progress" aria-hidden="true"></div>

            <div class="kaivyra-medical-topics">

                <article class="kaivyra-medical-topic" data-topic="01">
                    <div class="kaivyra-medical-topic-number">01</div>
                    <div class="kaivyra-medical-topic-content">
                        <div class="kaivyra-medical-topic-kicker">THE HUMAN</div>
                        <h2>Who Is Being Served?</h2>
                        <p>
                            Life stage, population, disability, patient goals,
                            lived experience, social context and human factors.
                        </p>
                        <div class="kaivyra-medical-depth">
