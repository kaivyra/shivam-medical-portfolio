  line-height:1.65;
}


/* EXACT 10cm × 10cm CARDS */

.build-ultra-grid{
  display:grid;

  grid-template-columns:repeat(3, 10cm);

  justify-content:center;

  gap:18px;

  padding:8px 4px 12px;

  overflow-x:auto;
  scrollbar-width:thin;
}

.build-ultra-card{
  position:relative;

  width:10cm;
  height:10cm;

  min-width:10cm;
  min-height:10cm;

  box-sizing:border-box;

  padding:28px;

  display:flex;
  flex-direction:column;

  border:2px solid #38bdf8;
  border-radius:22px;

  background:
    radial-gradient(
      circle at 88% 8%,
      rgba(56,189,248,.13),
      transparent 32%
    ),
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f8fcff 100%
    );

  box-shadow:
    0 0 0 1px rgba(56,189,248,.08),
    0 12px 32px rgba(14,116,144,.10),
    inset 0 0 35px rgba(56,189,248,.025);

  overflow:hidden;

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.build-ultra-card::before{
  content:"";

  position:absolute;

  inset:7px;

  border:1px solid rgba(56,189,248,.13);
  border-radius:16px;

  pointer-events:none;
}

.build-ultra-card::after{
  content:"";

  position:absolute;

  width:100px;
  height:100px;

  right:-48px;
  top:-48px;

  border-radius:50%;

  background:rgba(56,189,248,.10);

  pointer-events:none;
}

.build-ultra-card:hover{
  transform:translateY(-7px);

  border-color:#0ea5e9;

  box-shadow:
    0 0 0 3px rgba(56,189,248,.10),
    0 22px 50px rgba(14,116,144,.17),
    0 0 28px rgba(56,189,248,.12);
}

.build-card-number{
  position:relative;
  z-index:2;

  color:#0284c7;

  font-size:11px;
  font-weight:700;
  letter-spacing:.1em;
}

.build-card-icon{
  position:relative;
  z-index:2;

  width:50px;
  height:50px;

  margin-top:25px;

  display:flex;
  align-items:center;
  justify-content:center;

  border:1px solid rgba(56,189,248,.38);
  border-radius:15px;

  color:#0284c7;

  background:
    linear-gradient(
      145deg,
      #e0f2fe,
      #f0f9ff
    );

  box-shadow:
    0 8px 22px rgba(14,116,144,.10);

  font-family:'Poppins',sans-serif;
  font-size:14px;
  font-weight:700;
}

.build-ultra-card h4{
  position:relative;
  z-index:2;

  margin-top:21px;

  color:var(--ink);

  font-family:'Poppins',sans-serif;

  font-size:17px;
  line-height:1.3;
  font-weight:600;
}

.build-ultra-card p{
  position:relative;
  z-index:2;

  margin-top:9px;

