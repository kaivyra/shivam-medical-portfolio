<div
  id="kaivyra-build-view"
  class="kaivyra-build-view"
  aria-hidden="true"
>

  <div class="kaivyra-build-shell">


    <header class="kaivyra-build-header">

      <button
        type="button"
        id="kaivyra-build-back"
        class="kaivyra-build-back"
        aria-label="Back to What We Build"
      >

        <span class="kaivyra-back-icon">
          ←
        </span>

        <span>
          Back
        </span>

      </button>


      <div class="kaivyra-build-header-brand">

        <span class="kaivyra-build-header-label">
          KAIVYRA
        </span>

        <span class="kaivyra-build-header-divider"></span>

        <span
          id="kaivyra-build-header-category"
          class="kaivyra-build-header-category"
        ></span>

      </div>


      <button
        type="button"
        id="kaivyra-build-close"
        class="kaivyra-build-close"
        aria-label="Close"
      >
        ×
      </button>

    </header>


    <main class="kaivyra-build-main">

      <div class="kaivyra-build-intro">

        <div
          id="kaivyra-build-number"
          class="kaivyra-build-detail-number"
        ></div>


        <div>

          <div class="section-kicker">
            KAIVYRA / EXPLORATION
          </div>

          <h1
            id="kaivyra-build-title"
            class="kaivyra-build-title"
          ></h1>

          <p
            id="kaivyra-build-description"
            class="kaivyra-build-description"
          ></p>

