  height:34px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:0;

  border:1px solid rgba(255,255,255,.13);
  border-radius:50%;

  background:rgba(255,255,255,.06);
  color:#fff;

  cursor:pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}

.kaivyra-search-btn:hover{
  background:rgba(255,255,255,.14);
  transform:translateY(-1px);
}

.kaivyra-search-btn svg{
  width:14px;
  height:14px;
}

.kaivyra-search-panel{
  position:absolute;

  top:calc(100% + 12px);
  right:0;

  width:290px;
  padding:10px;

  border:1px solid #e5ebf2;
  border-radius:14px;

  background:#fff;

  box-shadow:0 22px 60px rgba(5,15,31,.20);

  opacity:0;
  visibility:hidden;
  transform:translateY(-6px);
  pointer-events:none;

  transition:
    opacity .16s ease,
    transform .16s ease,
    visibility .16s ease;

  z-index:400;
}

.kaivyra-search-wrap.open .kaivyra-search-panel{
  opacity:1;
  visibility:visible;
  transform:none;
  pointer-events:auto;
}

.kaivyra-search-input-row{
  display:flex;
  align-items:center;
  gap:8px;

  padding:2px;
}

.kaivyra-search-input{
  width:100%;

  height:38px;

  padding:0 11px;

  border:1px solid #dfe7ef;
  border-radius:9px;

  outline:none;

  color:#102039;
  background:#f8fafc;

  font-family:'Inter',sans-serif;
  font-size:12px;
}

.kaivyra-search-input:focus{
  border-color:#33c9c9;
  background:#fff;
  box-shadow:0 0 0 3px rgba(31,197,198,.10);
}

.kaivyra-search-results{
  max-height:260px;
  overflow-y:auto;

  margin-top:7px;
}

.kaivyra-search-empty{
  padding:12px 8px;

  color:#718096;

  font-size:11.5px;
  text-align:center;
}

.kaivyra-search-result{
  width:100%;

  display:block;

  padding:9px 10px;

  border:0;
  border-radius:9px;

  background:none;

  color:#102039;

  text-align:left;
  cursor:pointer;
}

.kaivyra-search-result:hover{
  background:#f0f8f9;
}

.kaivyra-search-result-title{
  display:block;

  font-size:12px;
  font-weight:600;
}

.kaivyra-search-result-text{
  display:block;

  margin-top:2px;

  color:#718096;

  font-size:10.5px;

  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.kaivyra-en-nav{
  font-weight:700 !important;
}

@media(max-width:760px){
  .kaivyra-search-wrap,
  .kaivyra-lang-wrap{
    display:none;
  }
}
/* KAIVYRA 36 BUILD BOXES START */

.kaivyra-building-section{
  overflow:hidden;
}

.build-category{
  margin-top:58px;
}

.build-category:first-of-type{
  margin-top:0;
}

.build-category-head{
  display:flex;
  align-items:flex-start;
  gap:18px;
  margin-bottom:22px;
}

.build-category-number{
  flex:0 0 auto;

  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  border:1px solid rgba(56,189,248,.55);
  border-radius:14px;

  color:#0284c7;
  background:linear-gradient(
    145deg,
    #f0f9ff,
    #ffffff
  );

  box-shadow:
    0 0 0 4px rgba(56,189,248,.06),
    0 10px 25px rgba(14,116,144,.08);

  font-family:'Poppins',sans-serif;
  font-size:12px;
  font-weight:700;
}

.build-category-head h3{
  font-size:22px;
  line-height:1.25;
  font-weight:600;
  color:var(--ink);
}

.build-category-head p{
