                <span class="kaivyra-medical-depth-chip" data-depth-index="27"><span class="kaivyra-medical-depth-index">27</span>Patient Burden</span>
                <span class="kaivyra-medical-depth-chip" data-depth-index="28"><span class="kaivyra-medical-depth-index">28</span>Caregiver Burden</span>
                <span class="kaivyra-medical-depth-chip" data-depth-index="29"><span class="kaivyra-medical-depth-index">29</span>Global Burden</span>
                <span class="kaivyra-medical-depth-chip" data-depth-index="30"><span class="kaivyra-medical-depth-index">30</span>Unmet Need</span>
            </div>
        
>
                    </div>
                </article>

                <article class="kaivyra-medical-topic" data-topic="06">
